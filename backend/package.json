{
  "name": "brr-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BRR API. Login stays in Keycloak. This package does not create the database.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
