# Copy to .env and set your own password before `docker compose up -d`.

PORT=3000

POSTGRES_USER=brr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brr
DATABASE_URL=postgresql://brr:change-me@127.0.0.1:5432/brr

# Keycloak is not running yet. Login fails with 401 until it exists.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=brr
KEYCLOAK_ISSUER=http://localhost:8080/realms/brr
KEYCLOAK_CLIENT_ID=brr-app
