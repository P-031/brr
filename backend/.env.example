# Copy to .env and set your own password before `docker compose up -d`.

PORT=3000

POSTGRES_USER=brr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brr
DATABASE_URL=postgresql://brr:change-me@127.0.0.1:5432/brr

# Issuer host must match the token. This Keycloak issues http://127.0.0.1:8080.
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=brr
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/brr
KEYCLOAK_CLIENT_ID=brr-app
