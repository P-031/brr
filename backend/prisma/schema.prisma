// Passwords stay in Keycloak. This database stores the cane-field data.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  FARMER
  OFFICER
}

enum TaskKind {
  PLANT
  FERTILIZE
  SPRAY
  HARVEST
}

enum RecordKind {
  PLOT
  YIELD
  TASK
}

model User {
  id          String   @id @default(cuid())
  keycloakId  String   @unique
  username    String   @unique
  role        Role
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plots      Plot[]
  caringFor  FarmerCare[] @relation("OfficerCare")
  caretakers FarmerCare[] @relation("FarmerCare")

  @@index([role])
}

/// One extension officer can follow many farmers.
model FarmerCare {
  officerId String
  farmerId  String
  createdAt DateTime @default(now())
  officer   User     @relation("OfficerCare", fields: [officerId], references: [id], onDelete: Cascade)
  farmer    User     @relation("FarmerCare", fields: [farmerId], references: [id], onDelete: Cascade)

  @@id([officerId, farmerId])
  @@index([farmerId])
}

model Plot {
  id        String                                 @id @default(cuid())
  farmerId  String
  name      String
  variety   String                                 @default("")
  areaSqm   Float
  centerLat Float
  centerLng Float
  /// Read and written with raw SQL in src/boundary.ts. Prisma Client cannot touch this column.
  boundary   Unsupported("geometry(Polygon, 4326)")?
  /// Bumped on every change. Offline edits must send the version they started from.
  version    Int                                    @default(1)
  surveyedAt DateTime?
  createdAt  DateTime                               @default(now())
  updatedAt  DateTime                               @updatedAt

  farmer  User          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  yields  YieldRecord[]
  tasks   FieldTask[]
  surveys PlotSurvey[]

  @@index([farmerId, createdAt, id])
  @@index([farmerId, updatedAt])
  @@index([boundary], type: Gist)
}

/// Every walk around a plot, oldest first. The newest one is the plot's boundary.
model PlotSurvey {
  id         String   @id @default(cuid())
  plotId     String
  startedAt  DateTime
  finishedAt DateTime
  /// [{ latitude, longitude, accuracyM, capturedAt }] in walking order.
  corners    Json
  areaSqm    Float
  createdAt  DateTime @default(now())
  plot       Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId, createdAt])
}

model YieldRecord {
  id         String   @id @default(cuid())
  plotId     String
  season     String
  weightTons Float
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  plot       Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId, createdAt])
  @@index([updatedAt])
}

model FieldTask {
  id        String   @id @default(cuid())
  plotId    String
  kind      TaskKind
  date      DateTime @db.Date
  done      Boolean  @default(false)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  plot      Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId, date])
  @@index([updatedAt])
}

/// Lets offline devices learn about deletes. Deleting a plot also removes its yields and tasks.
model DeletedRecord {
  kind      RecordKind
  recordId  String
  farmerId  String
  plotId    String?
  deletedAt DateTime   @default(now())

  @@id([kind, recordId])
  @@index([farmerId, deletedAt])
}
